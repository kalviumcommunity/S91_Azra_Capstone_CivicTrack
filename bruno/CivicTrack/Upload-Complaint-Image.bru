
meta {
  name: Upload Complaint Image
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/complaints/{{complaintId}}/upload
  body: multipartForm
  auth: bearer
}

headers {
  Content-Type: multipart/form-data
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  image: @file(/path/to/your/image.jpg)
}
